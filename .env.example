# ── Base de données (Neon en prod, n'importe quel PostgreSQL en local) ──
# URL poolée (host en -pooler) pour l'application
DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=verify-full"
# URL directe (sans -pooler) pour les migrations
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=verify-full"

# ── Site et authentification ──
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
BETTER_AUTH_URL="http://localhost:3001"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Compte administrateur (utilisé par le seed et scripts/admin-reset.ts) ──
ADMIN_EMAIL="admin@ordredunautilus.fr"
ADMIN_INITIAL_PASSWORD=""
# Destinataire des alertes (adhésions, messages, digest)
ADMIN_NOTIFY_EMAIL="admin@ordredunautilus.fr"

# ── E-mails (Resend). Vide = e-mails affichés dans la console ──
RESEND_API_KEY=""
MAIL_FROM="L'Ordre du Nautilus <noreply@ordredunautilus.fr>"

# ── Fichiers (Vercel Blob). Vide = écriture dans public/uploads ──
BLOB_READ_WRITE_TOKEN=""

# ── Webhook Discord (facultatif, activable dans Réglages) ──
DISCORD_WEBHOOK_URL=""

# ── Secrets techniques ──
# openssl rand -hex 24
CRON_SECRET=""
IP_HASH_SECRET=""
