{
  "name": "ordre-du-nautilus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:reset": "tsx scripts/admin-reset.ts",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "screenshots": "tsx scripts/screenshots.ts",
    "deploy:test": "bash scripts/deploy.sh test",
    "deploy:prod": "bash scripts/deploy.sh prod"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/fiber": "^9.8.1",
    "@vercel/blob": "^2.8.0",
    "better-auth": "1.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.6",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
